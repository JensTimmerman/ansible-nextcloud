---
extends: "default"
ignore: |
  .ansible/
  .molecule/
  tests/roles/
  molecule/*/roles/
rules:
  line-length:
    max: 160
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
